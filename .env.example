# Optional for higher GitHub API quotas. Never commit a real token.
SKILLOBS_GITHUB_TOKEN=

# SQLite works out of the box. For production, use a PostgreSQL SQLAlchemy URL.
SKILLOBS_DATABASE_URL=sqlite+pysqlite:///./skill_observatory.db

SKILLOBS_MAX_REPOSITORIES_PER_QUERY=50
SKILLOBS_REQUEST_TIMEOUT_SECONDS=30
